{
  "name": "local-harness-ai-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check renderer.js && node parity/check.mjs",
    "check:ui": "node parity/interact.mjs",
    "prepare-runtime": "node prepare-runtime.mjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.harness.ai",
    "productName": "local-harness-ai",
    "files": [
      "**/*",
      "!node_modules/.cache/**"
    ],
    "asar": true,
    "asarUnpack": [
      "runtime/**"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
